LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# Prefer Postgres in production (Neon free). When set, SQLite is ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local / fallback SQLite
DATABASE_PATH=./data/shifts.db

# Optional: skip signature verification for local dry-run (never enable in production)
# SKIP_SIGNATURE_VERIFY=false

# Translation and 機器人 Q&A (https://console.x.ai/ → API Keys)
# XAI_API_KEY=your_xai_api_key
# XAI_MODEL=grok-4.7
